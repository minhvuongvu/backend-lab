# Machine-specific port overrides for the lab. Copy to lab.env (not committed) and edit:
#   cp lab.env.example lab.env
# The root Makefile and every topic's experiments/Makefile load lab.env automatically, so
# `make obs-up`, experiments and k6 remote write all use the same ports. Defaults apply when unset.
# `make doctor` shows which default ports are already taken on this machine.

# Observability stack (shared/observability)
PROM_PORT=9090
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PYROSCOPE_PORT=4040
ALLOY_PORT=12345

# Experiments (shared/scaffold/experiments)
TOXIPROXY_API_PORT=8474
