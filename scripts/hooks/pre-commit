#!/usr/bin/env bash
# backend-lab pre-commit hook (install: `make hooks`).
# Always: size guard (no staged file over LAB_MAX_FILE_MB, default 10 MB, unless tracked by Git LFS;
#   nothing from topics/*/results/raw-samples/ except MANIFEST.json).
# Then the fast checks, only when lab tooling / docs / roadmap / topics are staged:
#   unit tests, roadmap prerequisite + learning-path check, hub linters, generated pages, py_compile, bash -n.
# The headless render check is slow (~30 s); enable it with LAB_RENDER_CHECK=1.
# Skip once with: git commit --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

step() { echo "[pre-commit] $*"; }

# ---- size guard: runs for every commit, before the path filter below ----
# GitHub rejects files > 100 MB and warns > 50 MB; one k6 `--out csv` run is easily ~95 MB.
max_mb="${LAB_MAX_FILE_MB:-10}"
max_bytes=$((max_mb * 1024 * 1024))
too_big=()
while IFS= read -r -d '' f; do
  if [[ "$f" == topics/*/results/raw-samples/* && "$f" != */MANIFEST.json ]]; then
    too_big+=("$f (raw-samples/ is local only)")
    continue
  fi
  size="$(git cat-file -s ":$f" 2>/dev/null || echo 0)"   # staged blob, not the working-tree file
  (( size > max_bytes )) || continue
  [[ "$(git check-attr filter -- "$f")" == *": filter: lfs" ]] && continue
  too_big+=("$f ($((size / 1024 / 1024)) MB)")
done < <(git diff --cached --name-only -z --diff-filter=ACMR)
if (( ${#too_big[@]} )); then
  step "size guard: FAILED (limit ${max_mb} MB per file, LAB_MAX_FILE_MB to change)"
  printf '  %s\n' "${too_big[@]}"
  cat <<'MSG'
  Full per-request samples (k6 --out csv) belong in topics/<slug>/results/raw-samples/ as *.csv.gz:
  that folder is gitignored, only its MANIFEST.json (name, bytes, sha256, rows, command, testid) is
  committed. Move the file there, then:
    git rm --cached <file>
    python3 scripts/raw_manifest.py update topics/<slug>/results/raw-samples
    git add topics/<slug>/results/raw-samples/MANIFEST.json
  results/raw/ keeps only small, analysis-ready files (k6 summary JSON, prom_export CSV, integrity
  JSON, run-order.csv, stats.py output). A file that must be versioned anyway: track it with Git LFS.
MSG
  exit 1
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! grep -qE '^(scripts/|templates/|shared/docs/|tests/|hub/|topics/|index\.html|README\.md|CLAUDE\.md|\.claude/rules/)' <<<"$staged"; then
  exit 0
fi

PY=""
for c in python3 python; do
  if "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then PY="$c"; break; fi
done
if [[ -z "$PY" ]]; then
  echo "[pre-commit] python >= 3.11 not found; skipping checks" >&2
  exit 0
fi
export PYTHONIOENCODING=utf-8

step "unit tests"
"$PY" -m unittest discover -s tests -q

step "roadmap: prerequisites, cycles, learning paths"
out="$("$PY" scripts/roadmap_order.py --check)" || { echo "$out"; exit 1; }
grep -q 'learning-path order problems: 0' <<<"$out" || { echo "$out"; exit 1; }

step "hub linters (insights, problems/glossary, benchmarks)"
"$PY" scripts/build_insights.py --check --no-page
"$PY" scripts/build_knowledge.py --check --no-page
"$PY" scripts/build_dashboard.py --check

step "generated pages up to date (index.html, hub/rules.html)"
"$PY" scripts/build_pages.py --check || { echo "[pre-commit] run: make pages (or python scripts/build_pages.py) and stage the result"; exit 1; }

step "syntax: python + shell"
"$PY" -m py_compile scripts/*.py
for f in scripts/*.sh scripts/hooks/pre-commit; do bash -n "$f"; done

if [[ "${LAB_RENDER_CHECK:-0}" == "1" ]]; then
  step "headless render check"
  "$PY" scripts/check_render.py
fi
step "ok"
