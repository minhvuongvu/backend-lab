    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU used (cores)",
      "description": "CPU cores consumed (1.0 = one full core). Source: Docker Engine API via docker-stats exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(lab_container_cpu_usage_seconds_total{compose_project=~\"$compose_project\", container=~\"$container\"}[$__rate_interval])",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU used vs limit",
      "description": "Only containers with a CPU limit. Sustained values near 100% mean the container is CPU-bound by its limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(lab_container_cpu_usage_seconds_total{compose_project=~\"$compose_project\", container=~\"$container\"}[$__rate_interval]) / (lab_container_cpu_limit_cores{compose_project=~\"$compose_project\", container=~\"$container\"} > 0)",
          "legendFormat": "{{container}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU throttling ratio",
      "description": "Share of CFS periods in which the container was throttled. ANY sustained throttling distorts latency results (p99 jumps by up to one CFS period, 100ms by default) even when average CPU looks low. Check this before trusting a latency comparison between implementations.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(lab_container_cpu_throttled_periods_total{compose_project=~\"$compose_project\", container=~\"$container\"}[$__rate_interval]) / (rate(lab_container_cpu_periods_total{compose_project=~\"$compose_project\", container=~\"$container\"}[$__rate_interval]) > 0)",
          "legendFormat": "{{container}}"
        }
      ]
    },
