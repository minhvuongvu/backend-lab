    {
      "id": 6,
      "type": "stat",
      "title": "Cache hit ratio",
      "description": "shared_buffers hit ratio. A cold cache in one run but not another skews comparisons — warm up first.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (compose_project) (rate(pg_stat_database_blks_hit{compose_project=~\"$compose_project\"}[$__rate_interval])) / (sum by (compose_project) (rate(pg_stat_database_blks_hit{compose_project=~\"$compose_project\"}[$__rate_interval])) + sum by (compose_project) (rate(pg_stat_database_blks_read{compose_project=~\"$compose_project\"}[$__rate_interval])))",
          "legendFormat": "{{compose_project}}",
          "instant": false
        }
      ]
    },
