        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(jvm_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(jvm_info, instance)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "backend-lab",
      "type": "dashboards",
      "tags": [
        "backend-lab"
