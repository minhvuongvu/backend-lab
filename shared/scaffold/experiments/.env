# Defaults for docker compose (override per run from the Makefile or the shell).
IMPL=before
APP_CPUS=2
APP_MEM=1g
PG_CPUS=2
PG_MEM=1g
DB_POOL_SIZE=10
TRACING_SAMPLING=0.0
# postgres exporter (shared/observability/exporters/postgres.yml)
PG_EXPORTER_URI=postgres:5432/lab?sslmode=disable
PG_EXPORTER_USER=lab
PG_EXPORTER_PASSWORD=lab
